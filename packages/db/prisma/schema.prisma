generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LegalAcceptance {
  id           String   @id @default(cuid())
  email        String
  passwordUsed String
  version      String
  timestamp    DateTime @default(now())

  @@index([email])
}

// --- Real, persistent backing for the cross-app SuperDash survey feed (previously a
// dormant-safe JSON file in foundingos-console, replaced now that a real DATABASE_URL
// exists). One row per tester survey submission from any brand website.
model SurveyEntry {
  id         String   @id @default(cuid())
  brand      String
  category   String
  tester     String?
  responses  Json
  timestamp  BigInt
  receivedAt DateTime @default(now())

  @@index([category])
  @@index([brand])
  @@map("survey_entries")
}

// Persisted tester program state (previously a dormant-safe JSON file in
// foundingos-console/app/tester/store.server.ts). One row per pre-issued tester credential.
model TesterSession {
  id                 String   @id
  email              String
  moduleId           String
  moduleLabel        String
  surveyId           String
  status             String
  currentAnswers     Json
  runs               Json
  // The literal password/access code used at the most recent login — additive, nullable
  // so existing rows (created before this field existed) remain valid without backfill.
  lastCredentialUsed String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("tester_sessions")
}

model PreviewVisitor {
  id             String   @id @default(cuid())
  email          String   @unique
  signInCount    Int      @default(1)
  firstSignedInAt DateTime @default(now())
  lastSignedInAt DateTime @default(now())
  lastReturnPath String?
  lastReferrer   String?
  lastUserAgent  String?
  lastIpHash     String?

  @@index([lastSignedInAt])
  @@map("preview_visitors")
}

// Historical anomaly detections (SuperDashAnomaly output for category tiles, plus brand-
// level high/low-engagement Autonomous triggers). category/message/score cover the
// existing category-level use; brandName/totalEngagement/categoryBreakdown are additive,
// nullable fields used only by the newer brand-level trigger (see
// brand-metric-store.server.ts). "triggeredAt" from the spec maps onto detectedAt — a
// second, duplicate timestamp field would be redundant.
model AnomalyLog {
  id                String   @id @default(cuid())
  category          String?
  message           String
  score             Float
  detectedAt        DateTime @default(now())
  brandName         String?
  totalEngagement   Int?
  categoryBreakdown Json?

  @@index([category])
  @@index([brandName])
  @@map("anomaly_logs")
}

// Historical engagement snapshots — category/submissionCount/score cover the existing
// category-level use; brandName/totalEngagement/categoryBreakdown are additive, nullable
// fields used only by the newer brand-level high-engagement trigger. "triggeredAt" from the
// spec maps onto recordedAt.
model EngagementLog {
  id                String   @id @default(cuid())
  category          String?
  submissionCount   Int?
  score             Float
  recordedAt        DateTime @default(now())
  brandName         String?
  totalEngagement   Int?
  categoryBreakdown Json?

  @@index([category])
  @@index([brandName])
  @@map("engagement_logs")
}

// Autonomous Verification Layer (AVL) — a single flexible log table covering every kind of
// row the verification loop writes: 'snapshot' (last-known-good module map, one per run),
// 'drift' (a detected difference from the prior snapshot), 'safeFix' (a deterministic,
// reversible action AVL actually took), 'needsApproval' (a high-risk item sitting in the
// GuardianQueue until a human resolves it), and 'freezePass' (the result of a post-fix
// health check). Kept as one table (matching the existing AnomalyLog/EngagementLog
// "flexible, additive fields" pattern) rather than several near-empty tables.
model DriftLog {
  id        String   @id @default(cuid())
  runId     String
  kind      String
  app       String?
  path      String?
  message   String
  detail    Json?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([kind])
  @@map("drift_logs")
}

// Real, honest monetary layer — informational only (no payment processor exists anywhere in
// this OS; see package-model-d.ts's own header). Every value here defaults to real zero
// rather than fabricated revenue: this is a genuinely new product with no real paying
// customers yet, so zero is the honest starting state, not a placeholder. Values are set only
// by a real admin action (via the matching store.server.ts function), never auto-populated
// with illustrative numbers. currency is the row's OWN stored base currency (per-row, since
// different brands may reasonably bill in different currencies later) — FX conversion is a
// read-only DISPLAY layer on top (see /api/fx/rates) and never writes back here.

/// Package Model D — one row per brand's real subscription state (base tier + industry pack),
/// replacing the previous "activation tracked client-side only" note in package-model-d.ts.
/// price/mrr/arr are snapshots captured at the real admin action that set this row, not live
/// recalculations, matching how real billing systems snapshot price at subscription time.
/// @deprecated Legacy per-brand billing model — see the `Brand` model's
/// deprecation note and docs/deprecations.md. New billing must use
/// `TenantSuiteLicense` (see docs/shared-schema.md).
model BrandSubscription {
  id           String   @id @default(cuid())
  brandSlug    String   @unique
  baseTier     String?
  industryPack String?
  price        Float    @default(0)
  mrr          Float    @default(0)
  arr          Float    @default(0)
  currency     String   @default("GBP")
  status       String   @default("none")
  // Additive — populated only by the real Stripe webhook (packages/billing's
  // syncSubscriptionFromStripe), which previously wrote a separate, dead
  // per-user Subscription model (removed in the 20260925090000 migration).
  stripeCustomerId     String?
  stripeSubscriptionId String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("brand_subscriptions")
}

/// CRM Deals — one row per real deal, replacing the previous hardcoded sample text (e.g.
/// "£3.2k") in packages/ui/src/console.tsx's makeRows. Also serves as the real source for the
/// SuperDash cross-brand pipeline rollup (probabilityWeightedValue = dealValue * (probability
/// implied by stage), computed at read time in the store — not duplicated into a second table).
/// @deprecated Legacy per-brand CRM model — see the `Brand` model's
/// deprecation note and docs/deprecations.md. Scheduled for removal once
/// the unified schema migration lands.
model CrmDeal {
  id                       String   @id @default(cuid())
  brandSlug                String
  name                     String
  stage                    String   @default("New")
  dealValue                Float    @default(0)
  currency                 String   @default("GBP")
  expectedValue            Float    @default(0)
  probabilityWeightedValue Float    @default(0)
  owner                    String?
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())

  @@index([brandSlug])
  @@map("crm_deals")
}

/// Finance module (per brand) AND Brand-console earnings — the same real numbers serve both
/// roles (one source of truth, not two near-duplicate tables): "Finance module: revenue,
/// expenses, profit" and "Brand consoles: brandRevenue, brandProfit" are the identical real
/// figures viewed from two different pages, so brandRevenue/brandProfit are read as aliases of
/// revenue/profit rather than stored a second time.
/// @deprecated Legacy per-brand finance model — see the `Brand` model's
/// deprecation note and docs/deprecations.md.
model BrandFinance {
  id        String   @id @default(cuid())
  brandSlug String   @unique
  revenue   Float    @default(0)
  expenses  Float    @default(0)
  profit    Float    @default(0)
  currency  String   @default("GBP")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("brand_finances")
}

// Accounting module (per brand) — real invoice totals, separate from BrandFinance's
// revenue/expenses/profit rollup since an invoice can be raised (and sit outstanding) before
// it ever becomes recognized revenue.
model AccountingInvoice {
  id                 String   @id @default(cuid())
  brandSlug          String
  invoiceNumber      String
  invoiceAmount      Float    @default(0)
  paidAmount         Float    @default(0)
  outstandingAmount  Float    @default(0)
  currency           String   @default("GBP")
  status             String   @default("draft")
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@index([brandSlug])
  @@map("accounting_invoices")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  staff
  user
}

model Brand {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  accentColor   String
  websiteUrl    String
  consoleUrl    String
  users         User[]
  modules       Module[]
  subscriptions Subscription[]
  activityLogs  ActivityLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id            String        @id @default(cuid())
  brandId       String?
  brand         Brand?        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name          String
  email         String        @unique
  passwordHash  String
  role          Role          @default(user)
  image         String?
  emailVerified DateTime?
  subscriptions Subscription[]
  activityLogs  ActivityLog[]
  accounts      Account[]
  sessions      Session[]
  surveyResults SurveyResult[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([brandId])
}

model Module {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, slug])
}

enum BillingState {
  trial
  active
  past_due
  cancelled
}

model Subscription {
  id        String   @id @default(cuid())
  brandId   String
  userId    String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String
  status    String
  startedAt DateTime @default(now())
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Package Activation System (Model D) — additive fields for the commercial layer.
  // All optional/defaulted so existing rows and existing code paths are unaffected.
  baseTier            String?
  industryPack        String?
  hardwarePacks       Json?
  quantumOSActive     Boolean       @default(false)
  intelligenceOSActive Boolean      @default(false)
  pricingModel        String?
  billingState        BillingState  @default(trial)
  stripeCustomerId    String?
  stripeSubscriptionId String?
  usageInsights       Int           @default(0)
  usageSimulations    Int           @default(0)
  usageAnomalyDetections Int        @default(0)
  usageRiskModels     Int           @default(0)
  usageScenarioPacks  Int           @default(0)
  surveyResults       SurveyResult[]

  @@index([brandId])
  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  brandId   String
  userId    String?
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([brandId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
enum SurveyType {
  customer
  buyer
  investor
}

enum SurveySentiment {
  positive
  neutral
  negative
}

model SurveyResult {
  id             String          @id @default(cuid())
  type           SurveyType
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  answers        Json
  score          Int
  insight        String
  risk           String
  opportunity    String
  sentiment      SurveySentiment
  createdAt      DateTime        @default(now())

  @@index([userId])
  @@index([subscriptionId])
  @@index([type])
}

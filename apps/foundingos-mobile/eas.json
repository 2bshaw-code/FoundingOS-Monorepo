{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "BRAND": "foundingos"
      }
    },
    "foundretail": {
      "extends": "production",
      "env": {
        "BRAND": "retail"
      }
    },
    "foundtalent": {
      "extends": "production",
      "env": {
        "BRAND": "talent"
      }
    },
    "foundfinance": {
      "extends": "production",
      "env": {
        "BRAND": "finance"
      }
    },
    "foundhealth": {
      "extends": "production",
      "env": {
        "BRAND": "health"
      }
    },
    "foundlogistics": {
      "extends": "production",
      "env": {
        "BRAND": "logistics"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6808996742"
      }
    },
    "foundretail": {},
    "foundtalent": {},
    "foundfinance": {},
    "foundhealth": {},
    "foundlogistics": {}
  }
}

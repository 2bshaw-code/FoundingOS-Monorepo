{
  "name": "founder-os-group",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "core-operations/*",
    "core-workforce/*",
    "core-intelligence/*",
    "shared/auth",
    "shared/bob",
    "shared/brand-assets",
    "shared/media",
    "shared/ui",
    "apps/foundingos-web",
    "apps/foundingos-console",
    "apps/core-intelligence-web",
    "apps/core-intelligence-console",
    "apps/core-intelligence-console-starter",
    "apps/core-operations-web",
    "apps/core-operations-console",
    "apps/core-operations-console-starter",
    "apps/core-workforce-web",
    "apps/core-workforce-console",
    "apps/core-workforce-console-starter",
    "apps/foundingos-mobile",
    "apps/foundthat-mobile",
    "packages/config",
    "packages/ui",
    "packages/auth",
    "packages/db",
    "packages/billing"
  ],
  "scripts": {
    "dev:next": "turbo dev --filter='./apps/*' --concurrency=19",
    "dev:locked": "turbo dev --filter=@foundingos/foundingos-website --filter=@foundingos/foundingos-console --filter=@foundingos/core-intelligence-web --filter=@foundingos/core-intelligence-console --filter=@foundingos/core_intelligence-console-starter --filter=@foundingos/core_operations-web --filter=@foundingos/core_operations-console --filter=@foundingos/core_operations-console-starter --filter=@foundingos/core_workforce-web --filter=@foundingos/core_workforce-console --filter=@foundingos/core_workforce-console-starter --concurrency=15",
    "build:next": "turbo build --filter='./apps/*'",
    "lint:next": "turbo lint --filter='./apps/*'",
    "db:generate": "npm run db:generate --workspace @foundingos/db",
    "db:migrate": "npm run db:migrate --workspace @foundingos/db",
    "build": "npm run verify:brand-assets && npm run verify:superdashboard-isolation && npm run verify:lockdown",
    "verify:brand-assets": "node scripts/verify-brand-assets.mjs",
    "verify:topology": "node scripts/verify-topology.mjs",
    "verify:superdashboard-isolation": "node scripts/verify-superdashboard-isolation.mjs",
    "verify:lockdown": "node scripts/verify-ecosystem-lockdown.mjs",
    "verify:backup-readiness": "node scripts/verify-backup-readiness.mjs",
    "verify:production-readiness": "node scripts/verify-production-readiness.mjs",
    "generate:site-access": "node scripts/generate-site-access.mjs",
    "verify:hydration-safety": "node scripts/verify-hydration-safety.mjs",
    "test:tester-system": "node --import tsx scripts/test-tester-system.mjs",
    "demo:credentials": "node scripts/load-demo-credentials.mjs",
    "test": "npm test --workspace @foundingos/auth && npm run test:tester-system",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "tsx": "^4.23.13",
    "turbo": "^2.5.6"
  },
  "allowScripts": {
    "electron@43.4.0": true
  },
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.0"
}

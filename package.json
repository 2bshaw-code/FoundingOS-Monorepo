{
  "name": "founder-os-group",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "core-operations/*",
    "core-workforce/*",
    "core-intelligence/*",
    "core-health/*",
    "!core-operations/frontend",
    "!core-workforce/frontend",
    "!core-intelligence/frontend",
    "shared/auth",
    "shared/bob",
    "shared/brand-assets",
    "shared/media",
    "shared/ui",
    "apps/foundingos-web",
    "apps/foundingos-console",
    "apps/core-intelligence-web",
    "apps/core-intelligence-console",
    "apps/core-intelligence-console-starter",
    "apps/core-operations-web",
    "apps/core-operations-console",
    "apps/core-operations-console-starter",
    "apps/core-workforce-web",
    "apps/core-workforce-console",
    "apps/core-workforce-console-starter",
    "apps/core-health-console",
    "apps/foundingos-mobile",
    "apps/foundretail-mobile",
    "apps/foundtalent-mobile",
    "apps/foundfinance-mobile",
    "apps/foundhealth-mobile",
    "apps/foundlogistics-mobile",
    "packages/config",
    "packages/ui",
    "packages/auth",
    "packages/db"
  ],
  "scripts": {
    "dev:next": "turbo dev --filter='./apps/*' --concurrency=19",
    "dev:locked": "PORT=4000 turbo dev --filter=@foundingos/foundingos-web --filter=@foundingos/foundingos-console --filter=@foundingos/core-intelligence-web --filter=@foundingos/core-intelligence-console --filter=@foundingos/core-intelligence-console-starter --filter=@foundingos/core-operations-web --filter=@foundingos/core-operations-console --filter=@foundingos/core-operations-console-starter --filter=@foundingos/core-workforce-web --filter=@foundingos/core-workforce-console --filter=@foundingos/core-workforce-console-starter --concurrency=15",
    "build:next": "turbo build --filter='./apps/*'",
    "lint:next": "turbo lint --filter='./apps/*'",
    "db:generate": "npm run db:generate --workspace @foundingos/db",
    "db:migrate": "npm run db:migrate --workspace @foundingos/db",
    "build": "npm run verify:brand-assets && npm run verify:superdashboard-isolation",
    "verify:brand-assets": "node scripts/verify-brand-assets.mjs",
    "verify:topology": "node scripts/verify-topology.mjs",
    "verify:superdashboard-isolation": "node scripts/verify-superdashboard-isolation.mjs",
    "verify:backup-readiness": "node scripts/verify-backup-readiness.mjs",
    "demo:credentials": "node scripts/load-demo-credentials.mjs",
    "test": "npm test --workspace @foundingos/auth",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "turbo": "^2.5.6"
  },
  "allowScripts": {
    "electron@43.4.0": true
  },
  "packageManager": "npm@11.19.0"
}

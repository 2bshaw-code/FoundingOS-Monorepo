generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core_intelligence"]
}

model AuthUser {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         String
  tenantId     String?
  active       Boolean         @default(true)
  sessions     AuthSession[]
  resets       PasswordReset[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@schema("core_intelligence")
}

model AuthSession {
  id                String    @id @default(uuid())
  userId            String
  user              AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String
  refreshTokenId    String
  deviceFingerprint String
  ipPrefix          String?
  expiresAt         DateTime
  rotatedAt         DateTime  @default(now())
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@schema("core_intelligence")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@schema("core_intelligence")
}

model MarketplaceMerchant {
  id             String    @id @default(cuid())
  name           String
  wrosMerchantId String?
  createdAt      DateTime  @default(now())
  products       Product[]

  @@schema("core_intelligence")
}

model Product {
  id         String              @id @default(cuid())
  title      String
  merchantId String
  merchant   MarketplaceMerchant @relation(fields: [merchantId], references: [id])

  @@schema("core_intelligence")
}

// Real forecasts computed from live Core.Operations data (orders, inventory, receivables).
// Never hand-authored numbers: `evidence` always carries the source values a forecast was
// derived from, so a founder can trace a projection back to real underlying data.
model IntelligenceForecastSnapshot {
  id               String   @id @default(cuid())
  tenantId         String
  metric           String
  horizonDays      Int
  method           String
  baselineValue    Float
  projectedValue   Float
  unit             String
  evidence         Json
  generatedBy      String
  createdAt        DateTime @default(now())

  @@index([tenantId, metric, createdAt])
  @@schema("core_intelligence")
}

// Founder-defined what-if comparisons. Baseline/projected metrics are always computed from
// real current Core.Operations data at creation time, not fabricated.
model IntelligenceScenario {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  assumptions       Json
  baselineMetrics   Json
  projectedMetrics  Json
  deltaSummary      String
  createdBy         String
  createdAt         DateTime @default(now())

  @@index([tenantId, createdAt])
  @@schema("core_intelligence")
}

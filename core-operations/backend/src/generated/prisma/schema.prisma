generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["wros"]
}

model AuthUser {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         String
  tenantId     String?
  permissions  Json?
  active       Boolean         @default(true)
  sessions     AuthSession[]
  resets       PasswordReset[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@schema("wros")
}

model AuthSession {
  id                String    @id @default(uuid())
  userId            String
  user              AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String
  refreshTokenId    String
  deviceFingerprint String
  ipPrefix          String?
  expiresAt         DateTime
  rotatedAt         DateTime  @default(now())
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@schema("wros")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@schema("wros")
}

model Merchant {
  id        String    @id @default(cuid())
  name      String
  package   String
  createdAt DateTime  @default(now())
  consoles  Console[]

  @@schema("wros")
}

model Console {
  id         String   @id @default(cuid())
  name       String
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  @@schema("wros")
}

model Lead {
  id          String    @id @default(cuid())
  tenantId    String
  source      String
  sourceRef   String?   @unique
  sourceUrl   String?
  companyName String
  contactName String?
  email       String?
  phone       String?
  itemTitle   String?
  stage       String    @default("new")
  valuePence  Int       @default(0)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, stage])
  @@schema("wros")
}

model Customer {
  id          String            @id @default(cuid())
  tenantId    String
  companyName String
  contactName String?
  email       String?
  phone       String?
  source      String?
  leads       Lead[]
  orders      SalesOrder[]
  messages    CustomerMessage[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId])
  @@schema("wros")
}

model SalesOrder {
  id              String    @id @default(cuid())
  tenantId        String
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  reference       String    @unique
  status          String    @default("open")
  totalPence      Int       @default(0)
  paymentStatus   String    @default("unpaid")
  paymentMethod   String?
  deliveryStatus  String    @default("unassigned")
  deliveryAddress String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, status])
  @@schema("wros")
}

model CustomerMessage {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  channel    String    @default("whatsapp")
  direction  String
  body       String
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@schema("wros")
}

model InventoryItem {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  sku            String
  category       String
  supplierName   String?
  supplierEmail  String?
  pricePence     Int       @default(0)
  stock          Int       @default(0)
  lowStockLevel  Int       @default(5)
  variants       Json?
  active         Boolean   @default(true)
  availability   String    @default("available")
  approvalStatus String    @default("approved")
  lastChangedBy  String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, category])
  @@schema("wros")
}

model MerchantChange {
  id          String    @id @default(cuid())
  tenantId    String
  itemId      String?
  submittedBy String
  action      String
  proposed    Json
  status      String    @default("pending")
  reviewedBy  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, status, createdAt])
  @@schema("wros")
}

model MerchantActivity {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@schema("wros")
}

model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  customerId    String?
  number        String    @unique
  status        String    @default("draft")
  subtotalPence Int       @default(0)
  taxPence      Int       @default(0)
  totalPence    Int       @default(0)
  dueAt         DateTime?
  paidAt        DateTime?
  sentAt        DateTime?
  items         Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments Payment[]

  @@index([tenantId, status])
  @@schema("wros")
}

model PaymentMethod {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String?
  type       String // card | mobile_money | bank_transfer
  provider   String? // m_pesa | mtn_momo | paystack | flutterwave | upi | stripe
  label      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payments Payment[]

  @@index([tenantId, customerId])
  @@schema("wros")
}

model Payment {
  id              String    @id @default(cuid())
  tenantId        String
  invoiceId       String?
  paymentMethodId String?
  amountPence     Int       @default(0)
  status          String    @default("pending")
  reconciledAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoice                Invoice?                @relation(fields: [invoiceId], references: [id])
  paymentMethod          PaymentMethod?          @relation(fields: [paymentMethodId], references: [id])
  mobileMoneyTransaction MobileMoneyTransaction?

  @@index([tenantId, status])
  @@schema("wros")
}

model MobileMoneyTransaction {
  id           String    @id @default(cuid())
  tenantId     String
  paymentId    String?   @unique
  provider     String // m_pesa | mtn_momo | paystack | flutterwave | upi
  reference    String
  msisdn       String?
  amountPence  Int       @default(0)
  status       String    @default("pending")
  rawPayload   Json?
  reconciledAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([tenantId, provider, status])
  @@schema("wros")
}

model RevenueRecognition {
  id              String   @id @default(cuid())
  tenantId        String
  invoiceId       String?
  recognizedPence Int      @default(0)
  recognizedAt    DateTime @default(now())
  period          String // e.g. "2026-09"
  createdAt       DateTime @default(now())

  @@index([tenantId, period])
  @@schema("wros")
}

model CashFlowPrediction {
  id                    String   @id @default(cuid())
  tenantId              String
  period                String // e.g. "2026-09"
  predictedInflowPence  Int      @default(0)
  predictedOutflowPence Int      @default(0)
  confidence            Float    @default(0)
  generatedAt           DateTime @default(now())

  @@index([tenantId, period])
  @@schema("wros")
}

model MarketingCampaign {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  objective    String
  audience     String
  platforms    Json
  status       String    @default("draft")
  scheduledAt  DateTime?
  impressions  Int       @default(0)
  engagements  Int       @default(0)
  conversions  Int       @default(0)
  revenuePence Int       @default(0)
  idea         String?
  caption      String?
  hashtags     String?
  adCopy       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, status])
  @@schema("wros")
}

model SocialPost {
  id          String    @id @default(cuid())
  tenantId    String
  campaignId  String?
  platforms   Json
  content     String
  mediaUrl    String?
  mediaType   String?
  status      String    @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?
  autoPost    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, status, scheduledAt])
  @@schema("wros")
}

model MediaGeneration {
  id        String   @id @default(cuid())
  tenantId  String
  format    String
  brief     String
  output    String
  context   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@schema("wros")
}

model DeliveryOperator {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  phone         String
  role          String   @default("rider")
  status        String   @default("available")
  phoneVerified Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId, status])
  @@schema("wros")
}

model DeliveryVehicle {
  id             String    @id @default(cuid())
  tenantId       String
  registration   String
  label          String
  vehicleType    String    @default("van")
  capacityKg     Int       @default(0)
  status         String    @default("available")
  currentLat     Float?
  currentLng     Float?
  lastLocationAt DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, registration])
  @@index([tenantId, status])
  @@schema("wros")
}

model DeliveryZone {
  id                    String   @id @default(cuid())
  tenantId              String
  name                  String
  postcodePrefixes      Json
  feePence              Int      @default(0)
  estimatedMinutes      Int      @default(0)
  feeMode               String   @default("zone")
  cashOnDeliveryAllowed Boolean  @default(false)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@schema("wros")
}

model DeliveryAssignment {
  id               String    @id @default(cuid())
  tenantId         String
  orderId          String
  operatorId       String?
  vehicleId        String?
  zoneId           String?
  status           String    @default("assigned")
  feePence         Int       @default(0)
  routeDistanceKm  Float     @default(0)
  estimatedMinutes Int       @default(0)
  originLat        Float?
  originLng        Float?
  destinationLat   Float?
  destinationLng   Float?
  timeline         Json
  assignedAt       DateTime  @default(now())
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, orderId])
  @@index([tenantId, status])
  @@schema("wros")
}

model DeliveryNotification {
  id           String    @id @default(cuid())
  tenantId     String
  assignmentId String?
  channel      String    @default("whatsapp")
  recipient    String
  message      String
  status       String    @default("queued")
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@schema("wros")
}

// Thin additive layer matching the console-requirements.md spec naming
// (Shipment/DeliveryTask/Route/Driver/Vehicle/LocationHistory) without
// renaming the existing DeliveryAssignment/DeliveryOperator/DeliveryVehicle
// models that routes, mobile apps, and shared UI already depend on. These
// give API consumers the spec-exact vocabulary where useful, while the
// existing models remain the source of truth for current functionality.
model Shipment {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String
  driverId  String?
  routeId   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, orderId])
  @@schema("wros")
}

model DeliveryTask {
  id          String    @id @default(cuid())
  tenantId    String
  shipmentId  String
  driverId    String?
  status      String    @default("pending")
  eta         DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, shipmentId])
  @@schema("wros")
}

model Route {
  id          String   @id @default(cuid())
  tenantId    String
  waypoints   Json
  distanceKm  Float?
  durationMin Int?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@schema("wros")
}

model Driver {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  vehicleId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId])
  @@schema("wros")
}

model Vehicle {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  plateNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, plateNumber])
  @@schema("wros")
}

model LocationHistory {
  id        String   @id @default(cuid())
  tenantId  String
  driverId  String
  lat       Float
  lng       Float
  timestamp DateTime @default(now())

  @@index([tenantId, driverId, timestamp])
  @@schema("wros")
}

// Spec-named Retail Console models (Product, Variant, InventoryMovement, Order).
// Additive alongside the existing InventoryItem/SalesOrder models above, following
// the same convention used for the Logistics Console spec models (Shipment etc.).
model Product {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  sku         String
  category    String    @default("General")
  description String?
  pricePence  Int       @default(0)
  active      Boolean   @default(true)
  variants    Variant[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, category])
  @@schema("wros")
}

model Variant {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  sku        String
  label      String
  pricePence Int      @default(0)
  stock      Int      @default(0)
  attributes Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@schema("wros")
}

model InventoryMovement {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String?
  variantId   String?
  warehouseId String?
  quantity    Int
  direction   String
  reason      String   @default("adjustment")
  createdAt   DateTime @default(now())

  @@index([tenantId, productId, createdAt])
  @@schema("wros")
}

model Order {
  id             String   @id @default(cuid())
  tenantId       String
  customerId     String?
  reference      String   @unique
  status         String   @default("open")
  totalPence     Int      @default(0)
  paymentStatus  String   @default("unpaid")
  deliveryStatus String   @default("unassigned")
  source         String   @default("web")
  items          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, status])
  @@schema("wros")
}

model LocationProfile {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  label             String   @default("Primary location")
  latitude          Float?
  longitude         Float?
  locality          String?
  countryCode       String?
  timezone          String?
  source            String   @default("manual")
  gpsEnabled        Boolean  @default(true)
  ipFallbackEnabled Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@schema("wros")
}

// Normalized cross-suite Event Feed store (Phase 7B). Every backend
// (Retail/Logistics/Finance live here in core-operations; Talent and
// Health publish over HTTP from their own services) writes here via
// POST /events/publish so every console/mobile app can read one
// unified, time-sorted activity stream regardless of which backend
// produced the event.
model Event {
  id        String   @id @default(cuid())
  type      String
  source    String
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
  @@schema("wros")
}

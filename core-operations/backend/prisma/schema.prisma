  requiresApproval      Boolean  @default(true)
  sourceEventId         String?
  input                 Json
  steps                 Json
  coordinationSummary   Json?
  historicalContext     Json?
  predictiveSignals     Json?
  simulationPreview     Json?
  outcomeSummary        String?
  outcomeAssessment     Json?
  trailEventIds         Json     @default("[]")

  action           AgentAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  status           String
  effects          Json
  compensation     Json?
  executedBy       String
  executedAt       DateTime
  reversedBy       String?
  reversedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, status, createdAt])
  @@schema("wros")
}

// Real, persisted record of which suite(s) a tenant is licensed to use.
// This is the single source of truth `createModuleAccessMiddleware`
// (see @foundingos/service-auth) checks before allowing non-founder_master
// access to any suite's gated routes — across Core.Operations,
// Core.Workforce, and Core.Intelligence. `suite` holds one of
// 'core_operations' | 'core_workforce' | 'core_intelligence'.
model TenantSuiteLicense {
  id          String    @id @default(cuid())
  tenantId    String
  suite       String
  planTier    String    @default("starter")
  enabled     Boolean   @default(true)
  seats       Int?
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, suite])
  @@index([tenantId, enabled])
  @@schema("wros")
}

/// Shared cross-suite telemetry sink (Phase 28). Implements the
/// `TelemetryEvent` envelope documented in /docs/telemetry.md. Distinct from
/// `Event` above: `Event` is the operational, tenant-facing cross-suite
/// event feed shown in-product (Insights, agent-action history); this model
/// is the observability/analytics sink intended for internal use
/// (dashboards, error-rate monitoring) and is never rendered directly to a
/// tenant. `tenantId` is nullable because pre-login/anonymous telemetry
/// (e.g. marketing-site funnel events) has no tenant yet.
model TelemetryEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  suite      String
  name       String
  actorType  String
  actorId    String?
  occurredAt DateTime
  properties Json
  receivedAt DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([suite, name, occurredAt])
  @@index([receivedAt])
  @@schema("wros")
}

/// Phase 34 — structured feature flag store, replacing ad-hoc booleans.
/// `key` is a flag identifier (e.g. "core_operations.advanced_marketing").
/// `enabled` is the flag's own kill switch — false always wins regardless
/// of rollout/overrides. `rolloutPercent` (0-100) gates a *default*
/// audience deterministically by tenantId+key hash (see feature-flags.ts),
/// so the same tenant always gets a stable answer without needing to store
/// a row per tenant for simple gradual rollouts. `tenantOverrides` is a
/// JSON map of tenantId -> boolean for exceptions that must not depend on
/// the rollout hash (e.g. an internal test tenant force-enabled ahead of a
/// wider rollout, or a specific tenant force-disabled after a support
/// escalation) — checked before the percentage rollout. `environment`
/// scopes a flag to `production`/`staging`/`all` so the same key can behave
/// differently outside production without needing separate keys.
model FeatureFlag {
  id              String   @id @default(cuid())
  key             String   @unique
  description     String?
  enabled         Boolean  @default(true)
  environment     String   @default("all")
  rolloutPercent  Int      @default(100)
  tenantOverrides Json     @default("{}")
  createdBy       String
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([environment, enabled])
  @@schema("wros")
}

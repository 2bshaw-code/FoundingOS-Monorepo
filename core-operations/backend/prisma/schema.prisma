generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["wros"]
}

model AuthUser {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         String
  tenantId     String?
  permissions  Json?
  active       Boolean         @default(true)
  sessions     AuthSession[]
  resets       PasswordReset[]
  messagingParticipants MessagingParticipant[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  invitations  TenantInvitation[] @relation("InvitationInvitee")
  sentMessages CustomerMessage[] @relation("MessageSender")
  assignedLeads     Lead[]     @relation("LeadAssignee")
  assignedCustomers Customer[] @relation("CustomerAssignee")

  @@schema("wros")
}

model TenantInvitation {
  id             String   @id @default(uuid())
  tenantId       String
  email          String
  role           String
  permissions    Json
  tokenHash      String   @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedBy      String
  acceptedUserId String?
  acceptedUser   AuthUser? @relation("InvitationInvitee", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, email, expiresAt])
  @@index([tenantId, acceptedAt, revokedAt])
  @@schema("wros")
}

model AuthSession {
  id                String   @id @default(uuid())
  userId            String
  user              AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String
  refreshTokenId    String
  deviceFingerprint String
  ipPrefix          String?
  expiresAt         DateTime
  rotatedAt         DateTime @default(now())
  revokedAt         DateTime?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@schema("wros")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@schema("wros")
}

model TenantBrandProfile {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  companyName       String
  tradingName       String?
  tagline           String?
  logoUrl           String?
  primaryColor      String   @default("#4A90E2")
  secondaryColor    String   @default("#101828")
  accentColor       String   @default("#7C3AED")
  headingFont       String   @default("Inter")
  bodyFont          String   @default("Inter")
  email             String?
  phone             String?
  website           String?
  address           String?
  registrationNumber String?
  taxNumber         String?
  defaultLocale     String   @default("en-GB")
  defaultCurrency   String   @default("GBP")
  invoicePrefix     String   @default("INV")
  paymentTerms      String?
  documentFooter    String?
  brandVoice        Json?
  socialLinks       Json?
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@schema("wros")
}

model BrandedDocument {
  id                  String   @id @default(cuid())
  tenantId            String
  documentType        String
  sourceId            String
  reference           String
  brandProfileVersion Int
  brandProfileSnapshot Json
  sourceSnapshot       Json
  contentType         String   @default("text/html")
  content             String
  generatedAt         DateTime @default(now())

  @@unique([tenantId, documentType, sourceId])
  @@index([tenantId, generatedAt])
  @@schema("wros")
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  package   String
  createdAt DateTime @default(now())
  consoles  Console[]

  @@schema("wros")
}

model Console {
  id         String   @id @default(cuid())
  name       String
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  @@schema("wros")
}

model Lead {
  id          String    @id @default(cuid())
  tenantId    String
  source      String
  sourceRef   String?   @unique
  sourceUrl   String?
  companyName String
  contactName String?
  email       String?
  phone       String?
  itemTitle   String?
  stage       String    @default("new")
  valuePence  Int       @default(0)
  tags        String[]  @default([])
  assignedUserId String?
  assignedUser   AuthUser? @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, stage])
  @@index([assignedUserId])
  @@schema("wros")
}

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  companyName String
  contactName String?
  email       String?
  phone       String?
  source      String?
  tags        String[] @default([])
  assignedUserId String?
  assignedUser   AuthUser? @relation("CustomerAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  leads       Lead[]
  orders      SalesOrder[]
  messages    CustomerMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([assignedUserId])
  @@schema("wros")
}

model SalesOrder {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  reference   String   @unique
  status      String   @default("open")
  totalPence  Int      @default(0)
  paymentStatus String @default("unpaid")
  paymentMethod String?
  deliveryStatus String @default("unassigned")
  deliveryAddress String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@schema("wros")
}

model CustomerMessage {
  id                String    @id @default(cuid())
  tenantId          String
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id])
  channel           String    @default("whatsapp")
  direction         String
  body              String
  // Real, honest lifecycle for outbound messages: "sent" once the WhatsApp Cloud API accepts
  // it, then "delivered"/"read" only when Meta's own status webhook reports it, or "failed" if
  // the send errored. Inbound messages are stored as "received". Never advanced without a
  // real webhook/API signal behind it.
  status            String    @default("sent")
  // WhatsApp's message ID for this send, used to match later delivered/read status webhooks
  // back to this row. Null for inbound messages (which arrive with their own provider ID
  // recorded on MessagingMessage instead) and for channels that don't return one.
  providerMessageId String?   @unique
  // Which FoundingOS user sent this (outbound only) — powers per-agent response analytics.
  // Null for inbound (customer-sent) messages and for sends made before this field existed.
  senderUserId      String?
  senderUser        AuthUser? @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  // Real inbound media (photo, voice note, document, video), downloaded from WhatsApp's Graph
  // API and stored via Vercel Blob — mediaUrl is a real, viewable URL, not a placeholder. Both
  // null when the message has no media or the download failed (the message still stores its
  // honest text placeholder in `body` either way).
  mediaUrl          String?
  mediaType         String?
  createdAt         DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([senderUserId])
  @@schema("wros")
}

model MessagingChannelConnection {
  id                String   @id @default(cuid())
  tenantId          String
  channel           String
  externalAccountId String
  displayName       String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([channel, externalAccountId])
  @@index([tenantId, channel])
  @@schema("wros")
}

model MessagingParticipant {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  user        AuthUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel     String
  address     String
  displayName String?
  role        String   @default("operator")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, channel, address])
  @@index([tenantId, active])
  @@index([userId])
  @@schema("wros")
}

model MessagingConversation {
  id                     String   @id @default(cuid())
  tenantId               String
  channel                String
  externalConversationId String
  participantAddress     String
  state                  Json?
  lastMessageAt          DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  messages               MessagingMessage[]

  @@unique([tenantId, channel, externalConversationId])
  @@index([tenantId, lastMessageAt])
  @@schema("wros")
}

model MessagingMessage {
  id                String                @id @default(cuid())
  tenantId          String
  conversationId    String
  conversation      MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerMessageId String                @unique
  direction         String
  messageType       String
  body              String?
  intent            String?
  status            String                @default("received")
  raw               Json?
  createdAt         DateTime              @default(now())

  @@index([tenantId, createdAt])
  @@index([conversationId, createdAt])
  @@schema("wros")
}

model InventoryItem {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  sku           String
  category      String
  supplierName  String?
  supplierEmail String?
  pricePence    Int      @default(0)
  stock         Int      @default(0)
  lowStockLevel Int      @default(5)
  variants      Json?
  active        Boolean  @default(true)
  availability String   @default("available")
  approvalStatus String @default("approved")
  lastChangedBy String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, category])
  @@schema("wros")
}

model MerchantChange {
  id          String   @id @default(cuid())
  tenantId    String
  itemId      String?
  submittedBy String
  action      String
  proposed    Json
  status      String   @default("pending")
  reviewedBy  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status, createdAt])
  @@schema("wros")
}

model MerchantActivity {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@schema("wros")
}

model Invoice {
  id            String   @id @default(cuid())
  tenantId      String
  customerId    String?
  number        String   @unique
  status        String   @default("draft")
  subtotalPence Int      @default(0)
  taxPence      Int      @default(0)
  totalPence    Int      @default(0)
